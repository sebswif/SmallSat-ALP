\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{smallsat2027}[2026/09/28 SmallSat 2027 paper style, adapted from the 2026 project]

\RequirePackage[letterpaper,margin=1in,columnsep=0.25in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{mathptmx}
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage[table]{xcolor}
\makeatletter
\@ifundefined{insert@pcolumn}{\let\insert@pcolumn\insert@column}{}
\makeatother
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}
\RequirePackage{float}
\RequirePackage{stfloats}
\RequirePackage{placeins}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[superscript]{cite}
\RequirePackage[hidelinks]{hyperref}

\setlength{\parindent}{0.15in}
\setlength{\parskip}{4pt plus 1pt minus 1pt}
\setlength{\textfloatsep}{8pt plus 2pt minus 2pt}
\setlength{\floatsep}{8pt plus 2pt minus 2pt}
\setlength{\intextsep}{8pt plus 2pt minus 2pt}
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\setcounter{secnumdepth}{0}

% Update these values when the author list or conference paper number is known.
\newcommand{\smallsatauthor}{Kankanala}
\newcommand{\smallsatconference}{41st Annual Small Satellite Conference}
\newcommand{\smallsatpaperid}{}

\pagestyle{fancy}
\fancyhf{}
\lfoot{\footnotesize \smallsatauthor}
\cfoot{\footnotesize \thepage}
\rfoot{\footnotesize \smallsatconference}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.3pt}

\titleformat{\section}
  {\normalsize\bfseries\raggedright}
  {}
  {0pt}
  {\MakeUppercase}
\titleformat{\subsection}
  {\normalsize\bfseries\itshape\raggedright}
  {}
  {0pt}
  {}
\titleformat{\subsubsection}
  {\normalsize\itshape\raggedright}
  {}
  {0pt}
  {}
\titlespacing*{\section}{0pt}{1.1ex plus 0.4ex minus 0.2ex}{0.4ex}
\titlespacing*{\subsection}{0pt}{0.9ex plus 0.3ex minus 0.2ex}{0.25ex}

\captionsetup{
  font=normalsize,
  labelfont=bf,
  labelsep=colon,
  justification=centering,
  skip=3pt
}

\setlist[itemize]{leftmargin=1.2em,itemsep=1pt,topsep=2pt}
\setlist[enumerate]{leftmargin=1.4em,itemsep=1pt,topsep=2pt}

\makeatletter
\renewcommand{\maketitle}{%
  \begin{center}
    {\fontsize{12}{14}\selectfont\bfseries \@title\par}
    \vspace{1em}
    {\normalsize \@author\par}
    \vspace{0.75em}
    {\normalsize \@date\par}
    \vspace{1em}
  \end{center}
}
\makeatother

\renewenvironment{abstract}
  {\noindent\textbf{ABSTRACT}\par\normalsize}
  {\par\vspace{0.75em}}

\newcommand{\keywords}[1]{%
  \noindent\textbf{Keywords:} #1\par\vspace{0.75em}
}

\newcommand{\todo}[1]{\textcolor{red}{\textbf{TODO:} #1}}
